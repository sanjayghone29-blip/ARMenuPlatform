@{
    Layout = null; // No shared layout — login page is fully self-contained
    ViewData["Title"] = "Login – AR Menu Platform";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons CDN (for the eye toggle and logo icon) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
            /* ── Page background ─────────────────────────────────────────── */
            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            }

            /* ── Card container ──────────────────────────────────────────── */
            .login-card {
                background: #ffffff;
                border-radius: 16px;
                box-shadow: 0 24px 64px rgba(0, 0, 0, 0.35);
                padding: 2.5rem 2.25rem;
                width: 100%;
                max-width: 420px;
            }

            /* ── Brand header ────────────────────────────────────────────── */
            .brand-icon {
                width: 56px;
                height: 56px;
                background: linear-gradient(135deg, #0ea5e9, #6366f1);
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 1rem;
            }

            .brand-icon i {
                font-size: 1.75rem;
                color: #ffffff;
            }

            .brand-name {
                font-size: 1.5rem;
                font-weight: 700;
                color: #0f172a;
                letter-spacing: -0.5px;
            }

            .brand-tagline {
                font-size: 0.85rem;
                color: #64748b;
            }

            /* ── Form controls ───────────────────────────────────────────── */
            .form-label {
                font-size: 0.85rem;
                font-weight: 600;
                color: #374151;
                margin-bottom: 0.35rem;
            }

            .form-control {
                border-radius: 10px;
                border: 1.5px solid #e2e8f0;
                padding: 0.65rem 0.9rem;
                font-size: 0.95rem;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

            .form-control:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.12);
            }

            /* Password wrapper for the eye-toggle button */
            .password-wrapper {
                position: relative;
            }

            .password-wrapper .form-control {
                padding-right: 2.8rem;
            }

            .toggle-password {
                position: absolute;
                right: 0.75rem;
                top: 50%;
                transform: translateY(-50%);
                background: none;
                border: none;
                color: #94a3b8;
                cursor: pointer;
                padding: 0;
                font-size: 1rem;
                line-height: 1;
            }

            .toggle-password:hover {
                color: #475569;
            }

            /* ── Submit button ───────────────────────────────────────────── */
            .btn-login {
                background: linear-gradient(135deg, #0ea5e9, #6366f1);
                border: none;
                border-radius: 10px;
                color: #fff;
                font-weight: 600;
                font-size: 1rem;
                padding: 0.7rem;
                width: 100%;
                transition: opacity 0.2s, transform 0.1s;
            }

            .btn-login:hover  { opacity: 0.92; }
            .btn-login:active { transform: scale(0.98); }

            /* ── Error alert ─────────────────────────────────────────────── */
            .alert-login {
                background: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 10px;
                color: #b91c1c;
                font-size: 0.875rem;
                padding: 0.75rem 1rem;
            }

            /* ── Footer ──────────────────────────────────────────────────── */
            .login-footer {
                font-size: 0.78rem;
                color: #94a3b8;
                text-align: center;
                margin-top: 1.5rem;
            }

            /* ── Responsive tweaks ───────────────────────────────────────── */
            @@media (max-width: 480px) {
                .login-card {
                    border-radius: 0;
                    min-height: 100vh;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    box-shadow: none;
                    padding: 2rem 1.5rem;
                }

                body {
                    align-items: stretch;
                }
            }
    </style>
</head>
<body>

    <div class="login-card">

        <!-- ── Brand ───────────────────────────────────────────────── -->
        <div class="text-center mb-4">
            <div class="brand-icon">
                <i class="bi bi-badge-ar"></i>
            </div>
            <div class="brand-name">AR Menu Platform</div>
            <div class="brand-tagline">Restaurant Management Console</div>
        </div>

        <!-- ── Error message (shown only when ViewBag.Error is set) ─ -->
        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="alert-login mb-3" role="alert">
                <i class="bi bi-exclamation-circle me-1"></i>
                @ViewBag.Error
            </div>
        }

        <!-- ── Login form ──────────────────────────────────────────── -->
        <!--
            asp-antiforgery is the Razor Tag Helper equivalent of
            Html.AntiForgeryToken() — required because the controller
            uses [ValidateAntiForgeryToken].
        -->
        <form method="post" action="/Login" autocomplete="off">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="mb-3">
                <label class="form-label" for="email">Email address</label>
                <input type="email"
                       class="form-control"
                       id="email"
                       name="email"
                       placeholder="you@example.com"
                       required
                       autofocus
                    value="@(Context.Request.Method == "POST" ? Context.Request.Form["email"].ToString() : "")"
            </div>

            <!-- Password with show/hide toggle -->
            <div class="mb-4">
                <label class="form-label" for="password">Password</label>
                <div class="password-wrapper">
                    <input type="password"
                           class="form-control"
                           id="password"
                           name="password"
                           placeholder="Enter your password"
                           required />
                    <button type="button"
                            class="toggle-password"
                            aria-label="Toggle password visibility"
                            onclick="togglePassword()">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
        </form>

        <!-- ── Footer ──────────────────────────────────────────────── -->
        <div class="login-footer">
            &copy; @DateTime.Now.Year AR Menu Platform &nbsp;·&nbsp;
            <a href="mailto:support@armenu.in" style="color:#94a3b8;">support&#64;armenu.in</a>
        </div>

    </div>

    <!-- Bootstrap 5 JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmREAs8NcEen3GWUAMaG87A/aA/+"
            crossorigin="anonymous">
    </script>

    <script>
            // Show / hide password toggle
            function togglePassword() {
                const input   = document.getElementById('password');
                const icon    = document.getElementById('eyeIcon');
                const isHidden = input.type === 'password';

                input.type       = isHidden ? 'text' : 'password';
                icon.className   = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
            }

    </script>

</body>
</html>
