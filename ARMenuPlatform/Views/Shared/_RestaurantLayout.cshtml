<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – AR Menu</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
        :root {
            --nav-height: 60px;
            --bg:         #f8fafc;
            --surface:    #ffffff;
            --border:     #e2e8f0;
            --text:       #1e293b;
            --muted:      #64748b;
            --accent:     #1d4ed8;
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            padding-top: var(--nav-height);
        }

        /* ── Navbar ─────────────────────────────────────────────────── */
        .owner-nav {
            position: fixed; top: 0; left: 0; right: 0;
            height: var(--nav-height);
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center;
            padding: 0 20px;
            z-index: 1000;
            gap: 12px;
        }

        .nav-brand {
            display: flex; align-items: center; gap: 9px;
            text-decoration: none; flex: 1; min-width: 0;
        }

        .nav-brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #1d4ed8, #6366f1);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 0.9rem;
            flex-shrink: 0;
        }

        .nav-brand-text {
            font-size: 0.9rem; font-weight: 700;
            color: var(--text);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }

        .nav-brand-sub {
            font-size: 0.7rem; font-weight: 400;
            color: var(--muted);
            display: block; line-height: 1;
        }

        /* Owner info + logout cluster */
        .nav-right {
            display: flex; align-items: center; gap: 10px; flex-shrink: 0;
        }

        .nav-owner-name {
            font-size: 0.8rem; font-weight: 600;
            color: var(--muted);
            display: none;  /* hidden on narrow phones */
        }

        @@media (min-width: 480px) {
            .nav-owner-name { display: block; }
        }

        .nav-avatar {
            width: 32px; height: 32px;
            background: linear-gradient(135deg, #1d4ed8, #6366f1);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            color: #fff; font-size: 0.72rem; font-weight: 700;
            flex-shrink: 0;
        }

        .btn-logout {
            font-size: 0.78rem; font-weight: 600;
            padding: 6px 12px; border-radius: 8px;
            background: #fef2f2; color: #b91c1c; border: none;
            text-decoration: none;
            display: inline-flex; align-items: center; gap: 4px;
            transition: background 0.15s;
            white-space: nowrap;
        }
        .btn-logout:hover { background: #fee2e2; color: #991b1b; }

        /* ── Page content ───────────────────────────────────────────── */
        .page-wrap {
            max-width: 900px;
            margin: 0 auto;
            padding: 28px 16px 60px;
        }

        /* ── Footer ─────────────────────────────────────────────────── */
        .owner-footer {
            text-align: center;
            font-size: 0.72rem;
            color: #cbd5e1;
            padding: 20px 16px 28px;
            border-top: 1px solid var(--border);
            margin-top: 40px;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<!-- ── Navbar ────────────────────────────────────────────────────────────── -->
<nav class="owner-nav">
    <a class="nav-brand" href="/Restaurant/Dashboard">
        <div class="nav-brand-icon">
            <i class="bi bi-badge-ar"></i>
        </div>
        <div>
            <div class="nav-brand-text" id="navRestaurantName">
                @(ViewBag.RestaurantNameNav ?? "My Restaurant")
            </div>
            <span class="nav-brand-sub">AR Menu</span>
        </div>
    </a>

    <div class="nav-right">
        @{
            var fullName = Context.Session.GetString("FullName") ?? "Owner";
            var initials = string.Join("", fullName.Split(' ').Take(2)
                               .Where(w => w.Length > 0).Select(w => w[0]));
        }
        <span class="nav-owner-name">@fullName</span>
        <div class="nav-avatar" title="@fullName">@initials</div>
        <a href="/Logout" class="btn-logout">
            <i class="bi bi-box-arrow-right"></i>
            <span class="d-none d-sm-inline">Logout</span>
        </a>
    </div>
</nav>

<!-- ── Page content ──────────────────────────────────────────────────────── -->
<div class="page-wrap">
    @RenderBody()
</div>

<!-- ── Footer ────────────────────────────────────────────────────────────── -->
<footer class="owner-footer">
    Powered by <strong style="color:#94a3b8;">AR Menu Platform</strong>
    &nbsp;·&nbsp; &copy; @DateTime.Now.Year
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmREAs8NcEen3GWUAMaG87A/aA/+"
        crossorigin="anonymous"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
