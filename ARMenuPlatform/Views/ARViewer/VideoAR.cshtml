@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>AR Viewer</title>

    <!-- A-Frame and MindAR A-Frame version -->
    <script src="https://aframe.io/releases/1.3.0/aframe.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.5/dist/mindar-image-aframe.prod.js"></script>

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg:       #0f172a;
            --text:     #f1f5f9;
            --muted:    #94a3b8;
            --accent:   #3b82f6;
            --surface:  rgba(15,23,42,0.85);
        }

        html, body {
            width: 100%; height: 100%;
            background: #000;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        #start-screen {
            position: fixed; inset: 0; z-index: 3000;
            background: var(--bg);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; padding: 32px; gap: 20px;
        }

        .start-icon { font-size: 4rem; }
        .start-title { font-size: 1.3rem; font-weight: 700; color: var(--text); }
        .start-subtitle { font-size: 0.9rem; color: var(--muted); max-width: 300px; line-height: 1.5; }

        .btn-start-ar {
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border: none; border-radius: 12px;
            color: #fff; font-weight: 700; font-size: 1rem;
            padding: 14px 32px; cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 4px 20px rgba(59,130,246,0.4);
            display: inline-flex; align-items: center; gap: 8px;
        }
        .btn-start-ar:active { transform: scale(0.96); }

        .btn-secondary {
            background: transparent; border: none;
            color: var(--muted); font-size: 0.9rem;
            padding: 10px 20px; cursor: pointer;
        }

        #ar-scene-wrapper {
            display: none;
            position: fixed; inset: 0; z-index: 1;
        }
        #ar-scene-wrapper.show { display: block; }

        #btn-back {
            display: none;
            position: fixed; top: 16px; left: 16px;
            z-index: 1000;
            width: 42px; height: 42px;
            background: var(--surface);
            border: none; border-radius: 50%;
            color: var(--text); font-size: 1.2rem;
            align-items: center; justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 12px rgba(0,0,0,0.4);
        }
        #btn-back.show { display: flex; }

        #dish-overlay {
            display: none;
            position: fixed; bottom: 0; left: 0; right: 0;
            z-index: 999;
            background: linear-gradient(to top, rgba(15,23,42,0.95) 0%, transparent 100%);
            padding: 32px 20px 28px;
            pointer-events: none;
        }
        #dish-overlay.show { display: block; }
        .dish-overlay-name { font-size: 1.1rem; font-weight: 800; color: var(--text); }
        .dish-overlay-price { font-size: 0.9rem; font-weight: 700; color: var(--accent); margin-top: 3px; }

        #instruction-banner {
            display: none;
            position: fixed; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            z-index: 999;
            text-align: center;
            pointer-events: none;
            transition: opacity 0.6s;
        }
        #instruction-banner.show { display: block; }

        .instruction-text {
            font-size: 0.9rem; font-weight: 600; color: var(--text);
            background: var(--surface);
            padding: 10px 20px; border-radius: 20px;
            display: inline-block;
            box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        }

        .scan-ring {
            width: 180px; height: 180px;
            border: 2px solid rgba(59,130,246,0.5);
            border-radius: 12px;
            margin: 0 auto 20px;
        }

        #fallback-screen {
            display: none;
            position: fixed; inset: 0; z-index: 2000;
            background: var(--bg);
            flex-direction: column;
            align-items: center; justify-content: center;
            text-align: center; padding: 32px; gap: 12px;
        }
        #fallback-screen.show { display: flex; }

        .fallback-icon { font-size: 3rem; }
        .fallback-title { font-size: 1.1rem; font-weight: 700; color: var(--text); }
        .fallback-sub { font-size: 0.82rem; color: var(--muted); max-width: 280px; line-height: 1.5; }

        #fallback-video {
            width: 100%; max-width: 340px;
            border-radius: 12px; display: none;
        }

        .btn-fallback-back {
            margin-top: 8px;
            background: var(--accent); border: none; border-radius: 10px;
            color: #fff; font-weight: 600; font-size: 0.9rem;
            padding: 10px 24px; cursor: pointer;
        }
    </style>
</head>
<body>

<div id="start-screen">
    <div class="start-icon">📱</div>
    <div class="start-title" id="start-dish-name">Dish</div>
    <div class="start-subtitle">
        Tap the button below to start AR.
        Then point your camera at the QR code on your table to see the dish come alive.
    </div>
    <button class="btn-start-ar" id="btn-start-ar">
        <span>▶</span> Start AR Camera
    </button>
    <button class="btn-secondary" onclick="goBack()">← Back to Menu</button>
</div>

<div id="ar-scene-wrapper"></div>

<button id="btn-back" onclick="goBack()" aria-label="Back to menu">←</button>

<div id="instruction-banner">
    <div class="scan-ring"></div>
    <div class="instruction-text">📷 Point camera at QR code on your table</div>
</div>

<div id="dish-overlay">
    <div class="dish-overlay-name" id="overlay-name"></div>
    <div class="dish-overlay-price" id="overlay-price"></div>
</div>

<div id="fallback-screen">
    <div class="fallback-icon">🎬</div>
    <div class="fallback-title" id="fallback-title">AR Not Available</div>
    <div class="fallback-sub" id="fallback-sub">Playing the dish video for you instead.</div>
    <video id="fallback-video" controls autoplay loop muted playsinline></video>
    <button class="btn-fallback-back" onclick="goBack()">← Back to Menu</button>
</div>

<script>
(function () {
    const params       = new URLSearchParams(window.location.search);
    const dishId       = params.get('dishId');
    const dishName     = params.get('dishName')   || 'Dish';
    const price        = params.get('price')       || '0';
    const contentURL   = params.get('contentURL')  || '';
    const qrCodeString = params.get('qrCodeString') || '';
    const qrImageUrl   = params.get('qrImageUrl')  || '';

    const mindFileUrl  = qrImageUrl ? qrImageUrl.replace(/\.png$/i, '.mind') : '';

    document.getElementById('start-dish-name').textContent = dishName;
    document.getElementById('overlay-name').textContent  = dishName;
    document.getElementById('overlay-price').textContent = '₹' + parseFloat(price).toFixed(0);

    window.goBack = function () {
        window.location.href = '/ar/menu/' + qrCodeString;
    };

    async function logDishView() {
        if (!qrCodeString || !dishId) return;
        try {
            await fetch('/api/scan/log', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    qrCodeString: qrCodeString,
                    dishId: parseInt(dishId),
                    scanType: 'DishView'
                })
            });
        } catch (_) { }
    }

    function showVideoFallback(reason) {
        document.getElementById('start-screen').style.display = 'none';
        document.getElementById('ar-scene-wrapper').classList.remove('show');

        document.getElementById('fallback-title').textContent =
            reason === 'no-mind' ? 'AR Marker Not Configured' : 'AR Not Available';
        document.getElementById('fallback-sub').textContent =
            reason === 'no-mind'
                ? 'The AR marker for this table has not been set up yet. Showing video preview instead.'
                : 'Your browser or device could not start AR. Showing the video instead.';

        if (contentURL) {
            var vid = document.getElementById('fallback-video');
            vid.src = contentURL;
            vid.style.display = 'block';
            vid.play().catch(function() {});
        }

        document.getElementById('fallback-screen').classList.add('show');
    }

    async function startAR() {
        if (!mindFileUrl) { showVideoFallback('no-mind'); return; }
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            showVideoFallback('no-camera'); return;
        }

        try {
            var probe = await fetch(mindFileUrl);
            if (!probe.ok) { showVideoFallback('no-mind'); return; }
        } catch (e) { showVideoFallback('no-mind'); return; }

        document.getElementById('start-screen').style.display = 'none';
        document.getElementById('btn-back').classList.add('show');
        document.getElementById('instruction-banner').classList.add('show');

        var wrapper = document.getElementById('ar-scene-wrapper');
        wrapper.innerHTML =
            '<a-scene id="arScene" ' +
              'mindar-image="imageTargetSrc: ' + mindFileUrl + '; autoStart: false; uiLoading: no; uiScanning: no; uiError: no;" ' +
              'color-space="sRGB" ' +
              'renderer="colorManagement: true; physicallyCorrectLights: true;" ' +
              'vr-mode-ui="enabled: false" ' +
              'device-orientation-permission-ui="enabled: false">' +
              '<a-assets>' +
                '<video id="dish-video-asset" src="' + contentURL + '" preload="auto" crossorigin="anonymous" loop muted playsinline webkit-playsinline></video>' +
              '</a-assets>' +
              '<a-camera position="0 0 0" look-controls="enabled: false"></a-camera>' +
              '<a-entity id="ar-target" mindar-image-target="targetIndex: 0">' +
                '<a-video id="ar-video" src="#dish-video-asset" position="0 0 0" rotation="0 0 0" width="1" height="1.5"></a-video>' +
              '</a-entity>' +
            '</a-scene>';
        wrapper.classList.add('show');

        var scene = document.getElementById('arScene');
        var dishVideo = document.getElementById('dish-video-asset');
        var target = document.getElementById('ar-target');

        target.addEventListener('targetFound', function () {
            document.getElementById('instruction-banner').classList.remove('show');
            document.getElementById('dish-overlay').classList.add('show');
            dishVideo.play().catch(function(err) { console.error('Video play error:', err); });
        });
        target.addEventListener('targetLost', function () {
            document.getElementById('instruction-banner').classList.add('show');
            dishVideo.pause();
        });

        if (!scene.hasLoaded) {
            await new Promise(function(r) { scene.addEventListener('loaded', r, { once: true }); });
        }

        var arSystem = scene.systems['mindar-image-system'];
        if (!arSystem) {
            alert('mindar-image-system not registered');
            showVideoFallback('ar-start-failed');
            return;
        }

        try {
            await arSystem.start();
            logDishView();
        } catch (err) {
            alert('AR start error: ' + (err.message || err));
            showVideoFallback('ar-start-failed');
        }
    }

    document.getElementById('btn-start-ar').addEventListener('click', function () {
        startAR();
    });

})();
</script>

</body>
</html>
